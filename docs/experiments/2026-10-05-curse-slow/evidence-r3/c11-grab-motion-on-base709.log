arent}\r\nhtml,body{height:100%;overflow:hidden;overscroll-behavior:none}\r\nbody{background:var(--bg);color:var(--ink);font-family:var(--font-body,"Microsoft JhengHei","PingFang TC",sans-serif);\r\n  font-size:14px;position:fixed;inset:0;width:100%;\r\n  -webkit-user-select:none;user-select:none;-webkit-touch-callout:none}\r\n*{touch-action:manipulation} /* 連點任何位置都不觸發 double-tap zoom（試玩回饋：視窗上跳）；下行捲動容器另開 pan-y */\r\n/* 字體分工（v0.59.0，凍結 p2 #6）：body 是內文黑體（--font-body）；標題、卡名、數字一律同一明體（--font-display）。\r\n   數字另有幾處原本就寫 var(--font-display)（壽命、押寶金額、隻數、跳字），token 換成明體後自動跟上。 */\r\nh1,h2,h3,.big,.bigbtn,#mainbtn,.mcard .nm,.seat .nm,#myDir,#myPow,.rcard .rnm,.nwTt,.nwH,.fighter .fnm,.railTabs button,\r\n.shname,.legendPick .lpn,.rvTile .v,.endrank,.mybid,.incamt,.windb,#duelBeat{font-family:var(--font-display)}\r\n/* 介面圖示（v0.59.0，凍結 p2 #1）：系統 emoji 由 js/ui-icons.js 在顯示端換成單色線條圖示（資料字串不動，trace 不變）。\r\n   圖示跟著字色與字級走；.icT 是換下來的原字（display:none，只為了讓 textContent 與換之前逐字相同）。 */\r\n.ic{display:inline-block;width:1.1em;height:1.1em;vertical-align:-.18em;margin:0 .06em;fill:none;stroke:currentColor;\r\n  stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;overflow:visible;flex:0 0 auto}\r\n.icT{display:none}\r\n#felt,#sheetbox,#modalbox,#review,#selGrid,#nwScr{touch-action:pan-y}\r\n/* 暈角（美術甲卷 v0.46，凍結檔 A5）：CSS 覆蓋層，不進 shader——手機上多一趟全畫面 fill 太貴，\r\n   而且暈角本來就是「疊在畫面最上面」的東西，用 DOM 做最便宜也最好調。\r\n   疊層：3D canvas 是 z-index:−2（renderer.js 設的），這層 −1，兩個都在 in-flow 的 UI 之下，\r\n   所以它蓋得到 3D、蓋不到任何面板與文字。pointer-events 關掉，不吃任何點擊。\r\n   0.62 是最外圈的黑度【試玩必調】。 */\r\n#vignette{position:fixed;inset:0;z-index:-1;pointer-events:none;\r\n  background:radial-gradient(ellipse 72% 78% at 50% 46%,rgba(0,0,0,0) 38%,rgba(0,0,0,.30) 72%,rgba(0,0,0,.62) 100%)}\r\n/* 高光轉場卷：純 DOM 疊層，蓋住牌桌但不建立 3D mesh／render pass。 */\r\n.cutOverlay{position:fixed;inset:0;z-index:48;pointer-events:none;display:flex;align-items:center;justify-content:center;\r\n  background:radial-gradient(ellipse at center,rgba(25,16,30,.08),rgba(4,3,8,.72));backdrop-filter:grayscale(.92) contrast(1.35)}\r\n.cutOverlay .cutStamp{min-width:220px;padding:18px 24px;border:2px solid var(--red);background:#190a10;color:#ffe9cf;\r\n  text-align:center;font-size:clamp(20px,2.8vw,28px);font-weight:800;letter-spacing:.18em;text-shadow:0 2px 0 #26060b,0 0 18px rgba(214,58,61,.7);transform:rotate(-3deg)}\r\n.cutOverlay.bluff .cutStamp{border-color:var(--gold);color:#ffe59a}.cutOverlay.borrowed-blade .cutStamp{border-color:#b278e8}.cutOverlay.death-edge .cutStamp{border-color:#e05b5b}\r\n.cutOverlay .cutSub{display:block;margin-top:7px;color:var(--ink);font-size:12px;font-weight:600;letter-spacing:.04em;text-shadow:none}\r\n@media (prefers-reduced-motion: reduce){ .cutOverlay{backdrop-filter:none;background:rgba(8,5,12,.82)} .cutOverlay .cutStamp{transform:none} }\r\n#rotateHint{display:none;position:fixed;inset:0;z-index:99;background:var(--bg);\r\n  flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center;padding:30px}\r\n#rotateHint .ic{font-size:52px;animation:rot 2s infinite}\r\n@keyframes rot{0%,20%{transform:rotate(0)}60%,100%{transform:rotate(90deg)}}\r\n@media (orientation:portrait){ #rotateHint{display:flex} }\r\n/* 直式：`#north` 的對話泡（`.bubble` bottom:-12px）與 ⓘ 鈕（`.roleInfoBtn` bottom:-7px）掛在座位卡**外側**，\r\n   會把固定 56px 的北列撐出 11px（`scrollHeight 67 / clientHeight 56`）。橫式早就修好了——\r\n   :103-104 那兩條——但它們被關在 :68 的 `@media (orientation:landscape)` 裡面，直式吃不到。\r\n   這是「直式與 kill switch 由建構上回到 v0.53」（:63-64）那條刻意設計的副作用，所以基準 0771e04\r\n   量到一模一樣的 11px。這裡補一段**直式專用**的同型修正：兩個 media query 互斥 ⇒\r\n   橫式一個字元都碰不到（U1 橫式與 U2 的 177/177 不受影響）。\r\n   ★限制寫明★：選擇器帶 `.t3d`，所以 `?table3d=0`（沒有 `.t3d`）的直式仍是 11px——\r\n   要連 kill switch 一起收就得改到 v0.53 直式的外觀，那一步留給製作人另裁。 */\r\n@media (orientation:portrait){\r\n  #table.t3d #north .seat .roleInfoBtn{bottom:1px}\r\n  #table.t3d #north .bubble{left:calc(100% + 6px);top:50%;bottom:auto;transform:translateY(-50%)}\r\n}\r\n/* 首頁（v0.59.0 畫面精美度第二階段「甲・讓桌」，凍結 p2 #7）：面板退場，標題、說明、三顆入口與版本號收到左下，\r\n   桌面當主角——推近的首頁機位與桌心聚光在 js/renderer.js（3D，不是 CSS 放大），只在首頁生效。 */\r\n.title{text-align:left;padding:22px 20px;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:flex-start}\r\n.title h1{font-size:46px;color:var(--gold);letter-spacing:18px;margin-bottom:0;text-shadow:0 0 24px rgba(232,120,40,.55),0 2px 3px #000}\r\n.title p{color:var(--dim);font-size:11px;line-height:1.6;max-width:440px;text-shadow:0 1px 2px #000,0 0 6px rgba(0,0,0,.9)}\r\n.title .btns{display:flex;flex-wrap:wrap;gap:22px;justify-content:flex-start;margin-top:10px}\r\n#titleScr .bigbtn{height:40px;padding:0 2px;background:transparent;box-shadow:none;border:0;border-bottom:1px solid var(--line-gold-soft);border-radius:0;\r\n  color:var(--gold);text-shadow:0 1px 3px #000}\r\n#titleScr .bigbtn:not(.alt){border-bottom:2px solid var(--gold);font-size:17px}\r\n/* 首頁的暈角：四周壓暗、光留給桌心（左下壓得最深，標題字才讀得到） */\r\nhtml.ysHome #vignette{background:radial-gradient(ellipse 62% 64% at 60% 42%,rgba(0,0,0,0) 30%,rgba(0,0,0,.42) 70%,rgba(0,0,0,.82) 100%)}\r\n#table{display:none;height:100%;height:100dvh;max-width:960px;margin:0 auto;\r\n  grid-template-areas:"north north north" "west felt east" "south south south";\r\n  grid-template-rows:56px 1fr 62px;grid-template-columns:120px 1fr 120px;gap:4px;padding:4px}\r\n#table.on{display:grid}\r\n#north{grid-area:north;display:flex;justify-content:center}\r\n#west{grid-area:west} #east{grid-area:east}\r\n#west,#east{display:flex;align-items:center}\r\n/* ===== 拍賣桌整片掏空 v0.55a（ROADMAP_V2 Top 1；凍結檔 docs/experiments/2026-09-10-acceptance-table3d.md）=====\r\n   `#north`／`#west`／`#east` 拆成「座位卡容器＋內容容器」，理由是 renderSeats() 直接覆寫這三個容器的 innerHTML\r\n   （計畫 §7 風險 4）：不拆的話市集卡會被座位卡整批洗掉，出現間歇性「卡片消失」。\r\n   **座位卡容器預設 display:contents** ⇒ 座位卡仍然是 #north／#west／#east 的直接 flex 項目，\r\n   v0.53 的版面因此逐像素不變（`?table3d=0` 與直式走的就是這條）。\r\n   掏空版面的每一條規則都只寫在 `#table.t3d` ＋ `@media (orientation:landscape)` 裡面\r\n   ⇒ 直式與 kill switch 由**建構上**回到 v0.53，不靠另寫一份覆蓋（Q6 甲）。 */\r\n#northSeat,#westSeat,#eastSeat{display:contents}\r\n#northPrev,#northShr{display:none}\r\n.rail{display:none}\r\n@media (orientation:landscape){\r\n  #table.t3d{grid-template-columns:168px minmax(0,1fr) 168px}   /* 原 120px 1fr 120px（Q5 甲：側欄 168px、桌心 492px）\r\n     ★minmax(0,…) 是必要的（v0.58.1 瀏海橫向卷）★：`1fr`＝minmax(auto,1fr)，而掏空的 #felt 是 overflow:visible，\r\n     自動最小寬＝min-content——#feltHead 單行不換行（月相 132＋縮寫＋心願條＋右側讓位 115）量到 496px。\r\n     iPhone 15 Pro 橫向 852 扣兩側安全區 59 只剩 734，桌心分到 390 < 496 ⇒ 整個 grid 撐寬 106px 往右溢出，\r\n     右側座位、請神列、主鈕被 html/body 的 overflow:hidden 直接切掉。桌心改成可縮，由 #feltHead 自己收（見下方 .wishbar）。 */\r\n  #table.t3d #west,#table.t3d #east{flex-direction:column;gap:4px;align-items:stretch}\r\n  #table.t3d #westSeat,#table.t3d #eastSeat{display:block;width:100%;min-width:0;flex:0 0 auto}\r\n  /* padding 的理由與 #market{padding:0 5px} 完全同一條（請神 2.0 凍結檔 G6）：`.markb`（left:-4px）與\r\n     `.mybid`／`.pickbox`（right:-4px／top:-8px）本來就掛在卡角**外側**，不留位置的話卡列會被撐出 3px 橫向溢出\r\n     （實測 #railW／#railE 各 3px），最上面那張卡的徽章還會壓到座位卡。留了之後徽章落在卡列內，徽章本身的視覺一格不動。 */\r\n  #table.t3d .rail{display:flex;flex-direction:column;gap:4px;flex:1 1 auto;min-height:0;padding:8px 5px 0;position:relative}\r\n  #table.t3d .rail .mcard{min-height:88px;height:auto;flex:0 0 auto;display:flex;flex-direction:column;justify-content:flex-start;padding:5px 7px} /* 內容決定高度，受惠徽章多一行也不穿底框或被撐成空卡 */\r\n  /* 拍品窄籤（v0.59.0，凍結 p2 #2）：每件一枚，全名、高 40、左緣（東欄右緣）一條系色條＋系色小方塊；\r\n     完整卡平時收起，點籤才在桌心那一側浮出（不佔側欄高度、不推擠座位卡）。 */\r\n  #table.t3d .railTabs{display:flex;flex-direction:column;align-items:flex-start;gap:4px;flex:0 0 auto}\r\n  #table.t3d #railE .railTabs{align-items:flex-end}\r\n  #table.t3d .railTabs button{height:40px;min-width:96px;max-width:100%;padding:0 10px 0 8px;\r\n    display:flex;align-items:center;gap:6px;white-space:nowrap;font-size:12px;font-weight:700;letter-spacing:.04em;line-height:1;\r\n    color:var(--ink);background:var(--c-ink-bg);border:1px solid var(--line-gold);border-left:3px solid var(--sys,var(--line-gold));border-radius:var(--r-panel);cursor:pointer}\r\n  #table.t3d #railE .railTabs button{flex-direction:row-reverse;padding:0 8px 0 10px;border-left:1px solid var(--line-gold);border-right:3px solid var(--sys,var(--line-gold))}\r\n  #table.t3d .railTabs button::before{content:"";width:'... 560499 more characters,
